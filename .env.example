# EKA ID Platform Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Note: Host port 5433 is mapped to container port 5432 to avoid local collisions
DB_HOST=localhost
DB_PORT=5433
DB_USER=eka_admin
DB_PASSWORD=eka_secure_dev_pass_2026
DB_NAME=eka_id
DB_SSL_MODE=disable

# Redis Configuration
# Note: Host port 6380 is mapped to container port 6379 to avoid local collisions
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# Security & Secrets (Change in Production!)
JWT_SECRET=eka_jwt_dev_super_secret_signing_key_32bytes_minimum_length_2026
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Mock OTP Settings (For local development)
MOCK_OTP_CODE=123456
OTP_EXPIRATION_MINUTES=5

# Public App URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
VERIFY_URL_PREFIX=http://localhost:3000/verify
